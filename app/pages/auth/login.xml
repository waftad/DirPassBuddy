<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo">
  <StackLayout class="p-4">
    <Label text="Mountain Bike Park" class="text-3xl font-bold text-center mb-8" />
    
    <TextField hint="Email" text="{{ email }}" keyboardType="email" class="input mb-4" />
    <TextField hint="Password" text="{{ password }}" secure="true" class="input mb-6" />
    
    <Button text="Login" tap="{{ onLogin }}" class="btn btn-primary mb-4" />
    <Button text="Register" tap="{{ onRegister }}" class="btn btn-secondary" />
  </StackLayout>
</Page>