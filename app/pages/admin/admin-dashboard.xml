<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo">
  <GridLayout rows="auto, *">
    <GridLayout row="0" columns="*, *, *" class="p-4 bg-primary">
      <Label col="0" text="{{ 'Active Riders: ' + activeRiders }}" class="text-white" />
      <Label col="1" text="{{ 'Daily Sales: $' + dailySales }}" class="text-white" />
      <Label col="2" text="{{ 'Pass Sales: ' + passSales }}" class="text-white" />
    </GridLayout>

    <TabView row="1" selectedIndex="{{ selectedTab }}">
      <!-- Active Riders -->
      <TabViewItem title="Riders">
        <GridLayout>
          <ListView items="{{ activeRidersList }}" class="list-group">
            <ListView.itemTemplate>
              <GridLayout columns="auto, *, auto" class="list-group-item p-2">
                <Image col="0" src="{{ profileImage }}" class="rounded-full h-10 w-10" />
                <StackLayout col="1" class="ml-2">
                  <Label text="{{ name }}" class="font-bold" />
                  <Label text="{{ 'Check-in: ' + checkInTime }}" class="text-sm" />
                </StackLayout>
                <Label col="2" text="{{ location }}" class="text-sm" />
              </GridLayout>
            </ListView.itemTemplate>
          </ListView>
        </GridLayout>
      </TabViewItem>

      <!-- Inventory -->
      <TabViewItem title="Inventory">
        <GridLayout rows="auto, *">
          <Button row="0" text="Add Product" tap="{{ onAddProduct }}" class="btn btn-primary m-2" />
          <ListView row="1" items="{{ inventory }}" class="list-group">
            <ListView.itemTemplate>
              <GridLayout columns="*, auto, auto" class="list-group-item p-2">
                <Label col="0" text="{{ name }}" />
                <Label col="1" text="{{ 'Stock: ' + stock }}" />
                <Button col="2" text="Update" tap="{{ $parent.onUpdateStock }}" class="btn btn-sm" />
              </GridLayout>
            </ListView.itemTemplate>
          </ListView>
        </GridLayout>
      </TabViewItem>

      <!-- Sales Reports -->
      <TabViewItem title="Reports">
        <ScrollView>
          <StackLayout class="p-4">
            <Label text="Sales Overview" class="text-xl font-bold mb-4" />
            
            <!-- Pass Sales Chart -->
            <GridLayout class="bg-white p-4 rounded">
              <Label text="Pass Sales by Type" class="font-bold" />
              <!-- Add chart component here -->
            </GridLayout>

            <!-- Store Sales Chart -->
            <GridLayout class="bg-white p-4 rounded mt-4">
              <Label text="Store Sales Trend" class="font-bold" />
              <!-- Add chart component here -->
            </GridLayout>

            <!-- Export Options -->
            <Button text="Export Reports" tap="{{ onExportReports }}" class="btn btn-secondary mt-4" />
          </StackLayout>
        </ScrollView>
      </TabViewItem>
    </TabView>
  </GridLayout>
</Page>